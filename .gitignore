# Rust build artifacts
/target

# Cargo.lock is kept (the examples are binaries, and it pins the wasm-bindgen
# version the CLI must match), so DO NOT ignore Cargo.lock.

# Reference papers / PDFs consulted while building (not redistributable)
/reference

# Screenshots from `cargo xtask shoot`. The scripts that produce them are
# tracked; the images are not, because nothing yet compares a run against a
# committed reference — see ROADMAP.md, "The harness".
/capture/*
!/capture/*.script

